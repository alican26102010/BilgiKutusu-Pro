# nginx server block ÖRNEĞİ — mevcut yapılandırmanızı yedeklemeden uygulamayın.
# Kiwix'in 127.0.0.1:8080 portunda, portalın 8081 portunda olduğu varsayılır.
server {
    listen 8081;
    server_name _;
    root /var/www/bilgikutusu;
    index index.html;
    autoindex off;

    location / {
        try_files $uri $uri/ =404;
    }

    # Kiwix ayrı servise ters vekil. Kiwix sürümünüzde alt-yol davranışını test edin.
    location /kiwix/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Yerel depolama yoluna örnek eşleme. Dizin listeleme KAPALI.
    location /kutuphane/ {
        alias /mnt/BilgiKutusu/;
        autoindex off;
        limit_except GET HEAD { deny all; }
    }
}
